<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolBarHeight"
        android:paddingHorizontal="@dimen/marginMedium">

        <ImageButton
            android:id="@+id/buttonMenu"
            android:layout_width="@dimen/imageButtonSize"
            android:layout_height="@dimen/imageButtonSize"
            android:layout_gravity="start|center_vertical"
            android:contentDescription="Menu"
            android:src="@drawable/ic_menu"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="?attr/colorSecondary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/playingFrom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Playing from"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorPrimary"
                android:textSize="@dimen/textSizeMedium"
                android:layout_gravity="center"/>

            <TextView
                android:id="@+id/playingFromPlaylist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Playlist qwertyuiopasdf"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:layout_gravity="center_horizontal"
                android:ellipsize="end"
                android:maxLines="1"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/buttonOptions"
            android:layout_width="@dimen/imageButtonSize"
            android:layout_height="@dimen/imageButtonSize"
            android:layout_gravity="end|center_vertical"
            android:layout_marginStart="@dimen/marginSmall"
            android:layout_marginEnd="@dimen/marginMedium"
            android:contentDescription="More options"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more"
            app:tint="?attr/colorSecondary"/>

        <ImageButton
            android:id="@+id/buttonSleepTimer"
            android:layout_width="@dimen/imageButtonSize"
            android:layout_height="@dimen/imageButtonSize"
            android:layout_gravity="end|center_vertical"
            android:layout_marginHorizontal="@dimen/marginSmall"
            android:contentDescription="Sleep timer"
            android:src="@drawable/ic_sleep_timer"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="?attr/colorSecondary" />

        <ImageButton
            android:id="@+id/buttonEqualizer"
            android:layout_width="@dimen/imageButtonSize"
            android:layout_height="@dimen/imageButtonSize"
            android:layout_gravity="end|center_vertical"
            android:layout_marginHorizontal="@dimen/marginSmall"
            android:contentDescription="Equalizer"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_eq"
            app:tint="?attr/colorSecondary"/>

        <ImageButton
            android:id="@+id/buttonQueue"
            android:layout_width="@dimen/imageButtonSize"
            android:layout_height="@dimen/imageButtonSize"
            android:layout_gravity="end|center_vertical"
            android:layout_marginHorizontal="@dimen/marginSmall"
            android:contentDescription="Queue"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_queue"
            app:tint="?attr/colorSecondary"/>

    </androidx.appcompat.widget.Toolbar>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/toolBarHeight">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/trackCover"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundedImage"
            app:srcCompat="@drawable/teto_cover"
            android:padding="@dimen/coverPadding"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintWidth_percent="0.35"
            app:layout_constraintDimensionRatio="1:1"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:id="@+id/songInfo"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/trackCover"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/seekBarContainer"
            android:gravity="center">

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <ImageButton
                android:id="@+id/addToPlaylist"
                android:layout_width="@dimen/imageButtonSize"
                android:layout_height="@dimen/imageButtonSize"
                android:contentDescription="Add To Playlist"
                android:src="@drawable/ic_add_to_playlist"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/colorSecondary"
                />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/trackName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cum for you"
                    android:textStyle="bold"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="?attr/colorPrimary"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:textSize="@dimen/textSizeLarge"/>

                <TextView
                    android:id="@+id/artistName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Govnorant"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="?attr/colorPrimary"
                    android:gravity="center"
                    android:layout_marginVertical="3dp"
                    android:textSize="@dimen/textSizeMedium"/>

                <TextView
                    android:id="@+id/queueCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="16/1699098"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textStyle="bold"
                    android:textSize="@dimen/textSizeSmall"
                    android:textColor="?attr/colorPrimary"
                    android:gravity="center"/>
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <ImageButton
                android:id="@+id/addToFavorites"
                android:layout_width="@dimen/imageButtonSize"
                android:layout_height="@dimen/imageButtonSize"
                android:contentDescription="Add To Favorites"
                android:src="@drawable/ic_favorite_border"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/colorSecondary" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/seekBarContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/marginLarge"
            app:layout_constraintStart_toEndOf="@id/trackCover"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/songInfo"
            app:layout_constraintBottom_toTopOf="@id/controls">

            <TextView
                android:id="@+id/timePlayed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:15"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:layout_marginHorizontal="@dimen/marginSmall"
                android:textSize="@dimen/textSizeSmall"/>

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:thumbTint="?attr/colorSecondary"
                android:progressTint="?attr/colorSecondary"
                android:layout_marginHorizontal="@dimen/marginSmall"/>

            <TextView
                android:id="@+id/timeRemaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1:54"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:layout_marginHorizontal="@dimen/marginSmall"
                android:textSize="@dimen/textSizeSmall"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/controls"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="@dimen/marginMedium"
            app:layout_constraintStart_toEndOf="@id/trackCover"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/seekBarContainer"
            app:layout_constraintBottom_toTopOf="@id/queueInfo">

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <ImageButton
                android:id="@+id/buttonShuffle"
                android:layout_width="@dimen/imageButtonSize"
                android:layout_height="@dimen/imageButtonSize"
                android:contentDescription="Shuffle songs"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_shuffle"
                app:tint="?attr/colorSecondary"
                android:layout_marginStart="@dimen/marginSmall"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <ImageButton
                android:id="@+id/buttonPrevious"
                android:layout_width="@dimen/imageButtonSize"
                android:layout_height="@dimen/imageButtonSize"
                android:scaleType="centerCrop"
                android:contentDescription="Previous"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_previous"
                app:tint="?attr/colorSecondary"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <ImageButton
                android:id="@+id/buttonPlayPause"
                android:layout_width="@dimen/playPauseButtonSize"
                android:layout_height="@dimen/playPauseButtonSize"
                android:scaleType="centerCrop"
                android:contentDescription="Play/Pause"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_play_circle"
                app:tint="?attr/colorSecondary"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <ImageButton
                android:id="@+id/buttonNext"
                android:layout_width="@dimen/imageButtonSize"
                android:layout_height="@dimen/imageButtonSize"
                android:scaleType="centerCrop"
                android:contentDescription="Next"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_next"
                app:tint="?attr/colorSecondary"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <ImageButton
                android:id="@+id/buttonRepeat"
                android:layout_width="@dimen/imageButtonSize"
                android:layout_height="@dimen/imageButtonSize"
                android:contentDescription="Repeat"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_repeat"
                app:tint="?attr/colorSecondary"
                android:layout_marginEnd="@dimen/marginSmall"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:id="@+id/queueInfo"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/marginSmall"
            app:layout_constraintStart_toEndOf="@id/trackCover"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/controls"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingHorizontal="@dimen/marginMedium">

                <TextView
                    android:id="@+id/playingNext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Playing next:"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/textSizeSmall"
                    android:textStyle="bold"
                    android:layout_gravity="center"/>

                <Space
                    android:layout_width="5dp"
                    android:layout_height="1dp" />

                <TextView
                    android:id="@+id/nextTrackInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mimukawa Nice Try - nununununununununununununununununununununun"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorPrimary"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:layout_marginVertical="@dimen/marginSmall"
                    android:textSize="@dimen/textSizeSmall"/>
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>